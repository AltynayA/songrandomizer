# Copy this file to .env and fill in real values. DO NOT commit .env.

# Postgres connection used by docker-compose (inside Docker network)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=444            # example only — change for production
POSTGRES_DB=spotify-songs
POSTGRES_HOST=postgres           # inside docker-compose use the service name
POSTGRES_PORT=5432               # container port; docker-compose maps host port 5433 -> container 5432

# If you run Postgres locally without Docker, set HOST=localhost and PORT=5433
# e.g.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
